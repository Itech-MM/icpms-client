<Window x:Class="icpms_client.Utils.UI.Toast.ToastHost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:toast="clr-namespace:icpms_client.Utils.UI.Toast"
        Title="ToastHost"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Focusable="False">
    <Window.Resources>
        <toast:ToastTypeToBrushConverter x:Key="ToastTypeToBrushConverter" />
        <toast:ToastTypeToBgConverter x:Key="ToastTypeToBgConverter" />
        <toast:ToastTypeToIconConverter x:Key="ToastTypeToIconConverter" />
        <toast:ToastTypeToSurfaceBrushConverter x:Key="ToastTypeToSurfaceBrushConverter" />
    </Window.Resources>
    <ItemsControl x:Name="ToastItemsControl">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type toast:ToastNotification}">
                <Border x:Name="ToastRoot"
                        Margin="10,10,10,10"
                        MinWidth="340" MaxWidth="420"
                        Background="Transparent"
                        Opacity="0"
                        RenderTransformOrigin="1,0.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.18" Color="Black" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform X="40" Y="0" />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.28">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Border x:Name="ToastSurface"
                            CornerRadius="10"
                            Background="{Binding Type, Converter={StaticResource ToastTypeToSurfaceBrushConverter}}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource PrimaryBorderColor}"
                            Loaded="Toast_Loaded">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Fill="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}}" />

                                <Border Grid.Column="1"
                                        Width="30" Height="30"
                                        CornerRadius="15"
                                        Margin="12,12,10,12"
                                        VerticalAlignment="Top"
                                        Background="{Binding Type, Converter={StaticResource ToastTypeToBgConverter}}">
                                    <fa:ImageAwesome Icon="{Binding Type, Converter={StaticResource ToastTypeToIconConverter}}"
                                                      Foreground="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,12,8,12">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibilityConverter}}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Command="{Binding DismissCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Top"
                                        Padding="4"
                                        Margin="0,10,10,0">
                                    <fa:ImageAwesome Icon="Times" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <Border x:Name="ProgressTrack"
                                    Grid.Row="1"
                                    Height="3"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource SecondaryBackgroundColor}"
                                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border x:Name="ProgressFill"
                                        HorizontalAlignment="Left"
                                        Background="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}}" />
                            </Border>
                        </Grid>
                    </Border>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>