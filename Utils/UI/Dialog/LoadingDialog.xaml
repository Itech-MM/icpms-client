<Window x:Class="icpms_client.Utils.UI.Dialog.LoadingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
    
    <Grid Background="Transparent">
        <!-- Modern loading spinner -->
        <Border Background="Transparent" 
                CornerRadius="12"
                Height="140"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Grid>
                <!-- Spinner animation with fewer tracks -->
                <Viewbox Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Ellipse x:Name="SpinnerCircle"
                                 Width="24" 
                                 Height="24" 
                                 Stroke="{DynamicResource PrimaryAccentColor}" 
                                 StrokeThickness="2"
                                 StrokeDashArray="2 10"
                                 StrokeDashCap="Round"
                                 StrokeLineJoin="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                From="0" To="360" Duration="0:0:1" 
                                                RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Canvas>
                </Viewbox>
                
                <!-- Loading message at the bottom -->
                <Border Background="Transparent" 
                        CornerRadius="0,0,12,12"
                        VerticalAlignment="Bottom"
                        Height="40"
                        Padding="0,8">
                    <TextBlock Text="{Binding LoadingText, RelativeSource={RelativeSource AncestorType=Window}}" 
                               FontSize="13" 
                               Foreground="{DynamicResource PrimaryBlackColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="10,0"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>