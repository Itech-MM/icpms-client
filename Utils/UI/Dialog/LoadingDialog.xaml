<Window x:Class="icpms_client.Utils.UI.Dialog.LoadingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Storyboard x:Key="Spin">
            <DoubleAnimation
                Storyboard.TargetName="SpinnerRotate"
                Storyboard.TargetProperty="Angle"
                From="0" To="360" Duration="0:0:1.1"
                RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="Entrance">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.9" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.9" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Card"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="Card"
                Opacity="0"
                CornerRadius="18"
                Padding="32,28"
                Margin="20"
                MinWidth="180"
                Background="{DynamicResource PrimaryBackgroundColor}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.9" ScaleY="0.9"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource Entrance}"/>
                </EventTrigger>
            </Border.Triggers>
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                   Direction="270"
                                   ShadowDepth="6"
                                   BlurRadius="28"
                                   Opacity="0.22" />
            </Border.Effect>
            <Border.OpacityMask>
                <SolidColorBrush Color="White"/>
            </Border.OpacityMask>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Gradient arc spinner -->
                <Viewbox Grid.Row="0" Width="42" Height="42"
                         HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Canvas Width="42" Height="42">
                        <!-- Faint full track -->
                        <Ellipse Width="42" Height="42"
                                  Stroke="{DynamicResource PrimaryBorderColor}"
                                  StrokeThickness="3.5"
                                  Opacity="0.25"/>
                        <!-- Animated gradient arc -->
                        <!-- Animated arc -->
                        <Path Data="M 39,21 A 18,18 0 0 1 21,39"
                              Stroke="{DynamicResource PrimaryAccentColor}"
                              StrokeThickness="3.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.OpacityMask>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.OpacityMask>
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource Spin}"/>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Canvas>
                </Viewbox>

                <TextBlock Grid.Row="1"
                           Text="{Binding LoadingText, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="13.5"
                           FontWeight="Medium"
                           Foreground="{DynamicResource PrimaryBlackColor}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="220"
                           Opacity="0.85"/>
            </Grid>
        </Border>
    </Grid>
</Window>