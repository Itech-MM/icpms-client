<local:BaseDialog x:Class="icpms_client.Utils.UI.Dialog.Common.MessageBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:icpms_client.Common.Converters"
        xmlns:local="clr-namespace:icpms_client.Utils.UI.Dialog"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Dialog">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="15,15">
            <DockPanel>
                <fa:FontAwesome FontSize="20" Margin="0,0,10,0" Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}" 
                         FontSize="16" 
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" 
                      HorizontalAlignment="Right" 
                      Margin="0,20,0,0">
                <Button Content="OK" 
                      Width="80" 
                      Margin="5" 
                      Click="Button_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Padding="0,5"
                      Tag="OK"/>
                <Button Content="Cancel" 
                      Width="80" 
                      Margin="5" 
                      Click="Button_Click"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Padding="0,5"
                      Tag="Cancel"
                      Visibility="{Binding ShowCancel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="Yes" 
                      Width="80" 
                      Margin="5" 
                      Click="Button_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Padding="0,5"
                      Tag="Yes"
                      Visibility="{Binding ShowYesNo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="No" 
                      Width="80" 
                      Margin="5" 
                      Click="Button_Click"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Padding="0,5"
                      Tag="No"
                      Visibility="{Binding ShowYesNo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Style="{StaticResource TabCloseButton}" Content="x"/>
    </Grid>
</local:BaseDialog>