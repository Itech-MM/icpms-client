<Window x:Class="icpms_client.Utils.UI.Dialog.MessageDialog.StyleMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        MinWidth="350">

    <Window.Resources>
        <!-- Message Type Colors -->
        <!--<SolidColorBrush x:Key="ErrorColor" Color="#EA5455"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF9F43"/>
        <SolidColorBrush x:Key="QuestionColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="InfoColor" Color="#28C76F"/>-->
        
        
        <!-- Button Type Icon Colors -->
        <SolidColorBrush x:Key="YesIconColor" Color="#28C76F"/>
        <SolidColorBrush x:Key="NoIconColor" Color="#EA5455"/>
        <SolidColorBrush x:Key="CancelIconColor" Color="#6C757D"/>
        <SolidColorBrush x:Key="OkIconColor" Color="#007ACC"/>
        
        <!-- Icon Style -->
        <Style x:Key="MessageIconStyle" TargetType="fa:ImageAwesome">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Icon" Value="InfoCircle"/>
            <Setter Property="Foreground" Value="{StaticResource InfoColor}"/>
            
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageType, RelativeSource={RelativeSource AncestorType=Window}}" Value="Error">
                    <Setter Property="Icon" Value="ExclamationCircle"/>
                    <Setter Property="Foreground" Value="{StaticResource ErrorColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MessageType, RelativeSource={RelativeSource AncestorType=Window}}" Value="Warning">
                    <Setter Property="Icon" Value="ExclamationTriangle"/>
                    <Setter Property="Foreground" Value="{StaticResource WarningColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MessageType, RelativeSource={RelativeSource AncestorType=Window}}" Value="Question">
                    <Setter Property="Icon" Value="QuestionCircle"/>
                    <Setter Property="Foreground" Value="{StaticResource QuestionColor}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Button Style with Button-Type Hover Effects -->
        <Style x:Key="MessageBoxButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderColor}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}">
                                <!--<ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextElement.FontFamily" Value="/Assets/Fonts/#Poppins" />
                                        <Setter Property="TextElement.Foreground" Value="#333333"/>
                                    </Style>
                                </ContentPresenter.Resources>-->
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
            <Style.Triggers>
                <!-- Yes Button -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Yes"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource YesHoverBackground}"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Yes"/>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource YesPressedBackground}"/>
                </MultiDataTrigger>
                
                <!-- No Button -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="No"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource NoHoverBackground}"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="No"/>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource NoPressedBackground}"/>
                </MultiDataTrigger>
                
                <!-- Cancel Button -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Cancel"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource CancelHoverBackground}"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Cancel"/>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource CancelPressedBackground}"/>
                </MultiDataTrigger>
                
                <!-- OK Button -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="OK"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource OkHoverBackground}"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="OK"/>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource OkPressedBackground}"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Primary"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MessageType}" Value="Error"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ErrorColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Primary"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MessageType}" Value="Warning"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource WarningColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Primary"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MessageType}" Value="Question"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource QuestionColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Primary"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MessageType}" Value="Information"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource InfoColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid MinWidth="300" Margin="20" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border BorderBrush="{DynamicResource PrimaryBorderColor}" 
                BorderThickness="1" 
                CornerRadius="8"
                Background="{DynamicResource PrimaryBackgroundColor}"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.2" />
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <fa:ImageAwesome x:Name="Icon" Style="{StaticResource MessageIconStyle}"/>
                    <TextBlock x:Name="TitleText" 
                               Text="Title" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Message Content -->
                <TextBlock x:Name="MessageText" 
                           Grid.Row="1" 
                           TextWrapping="Wrap"
                           FontSize="14"
                           Margin="0,0,0,20"
                           Text="Message content goes here"/>
                
                <!-- Buttons -->
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <StackPanel x:Name="ButtonsPanel" 
                                Orientation="Horizontal"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>