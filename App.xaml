<Application x:Class="icpms_client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialog="clr-namespace:icpms_client.Utils.UI.Dialog">
    <Application.Resources>
         <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Styles/LightTheme.xaml"/>
                <!-- Main styles -->
                <ResourceDictionary Source="MainStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="dialog:BaseDialog">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="dialog:BaseDialog">
                            <Grid Background="Transparent"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
                                <Border BorderBrush="{StaticResource PrimaryBorderColor}"
                                        BorderThickness="2"
                                        Background="White"
                                        CornerRadius="5"
                                        Margin="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                                          BlurRadius="10"
                                                          ShadowDepth="5"
                                                          Opacity="0.5" />
                                    </Border.Effect>
                                    <Grid>
                                        <ContentPresenter />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="3">
                                            <TextBlock FontSize="8" Text="Develop by" />
                                            <TextBlock FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryAccentColor}"
                                                       Margin="3,0,0,0"
                                                       Text="FlexiTech" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
