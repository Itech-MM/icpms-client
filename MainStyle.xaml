    <Style x:Key="SkeletonShimmerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform X="-1" Y="-1" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF222226" Offset="0.0" />
                    <GradientStop Color="#FF222226" Offset="0.35" />
                    <GradientStop Color="#FF3F3F47" Offset="0.5" />
                    <GradientStop Color="#FF222226" Offset="0.65" />
                    <GradientStop Color="#FF222226" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation
                            Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                            From="-1.5" To="1.5" Duration="0:0:1.3" />
                        <DoubleAnimation
                            Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.Y)"
                            From="-1.5" To="1.5" Duration="0:0:1.3" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
    
