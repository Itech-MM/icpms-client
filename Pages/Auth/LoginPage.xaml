<Page x:Class="icpms_client.Pages.Auth.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:icpms_client.Pages.Auth"
      xmlns:input="clr-namespace:icpms_client.UserControls.UI.Reusable.Inputs.Text"
      mc:Ignorable="d"
      Title="LoginPage" Height="620" Width="440">
    <Grid Background="{DynamicResource PrimaryBackgroundColor}">
        <Border Width="380" CornerRadius="10" Background="{DynamicResource PrimaryWhiteColor}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="6" BlurRadius="24" Opacity="0.18"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical">

                <!-- Header -->
                <Border Background="{DynamicResource AuthHeaderBackgroundColor}" Padding="0,28,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AuthHeaderAccentColor}"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="&#128737;" FontSize="22" Foreground="{DynamicResource PureWhiteColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="PARKING PRO" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PureWhiteColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="OPERATOR AUTHENTICATION" FontSize="10"
                                   Foreground="{DynamicResource AuthHeaderSubTextColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Body -->
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="Enter your credentials"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="OPERATOR ID" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,6"/>
                    <input:FormTextField x:Name="LoginNameField"
                                          ShowErrorMessage="True"
                                          PlaceHolder="XXXX"
                                          BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                          Color="{DynamicResource PrimaryBlackColor}"
                                          RoundedRadius="6"
                                          BorderSize="1"
                                          FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                          ContentPadding="12,10"
                                          Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="SECURITY KEY" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBlackColor}" HorizontalAlignment="Left"/>
                        <!--<TextBlock Text="Forgot Key?" FontSize="11" Foreground="{DynamicResource AuthHeaderBackgroundColor}"
                                   HorizontalAlignment="Right" Cursor="Hand"/>-->
                    </Grid>
                    <input:FormPasswordField x:Name="PasswordField"
                                              ShowErrorMessage="True"
                                              PlaceHolder="••••••••"
                                              BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                              Color="{DynamicResource PrimaryBlackColor}"
                                              RoundedRadius="6"
                                              BorderSize="1"
                                              FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                              ContentPadding="12,10"
                                              Margin="0,0,0,20"/>

                    <Button x:Name="LoginButton" Height="44"
                            Click="ButtonBase_OnClick"
                            Cursor="Hand"
                            IsEnabled="{Binding IsLoginEnabled, RelativeSource={RelativeSource AncestorType=Page}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource AuthHeaderBackgroundColor}" CornerRadius="6" Opacity="{TemplateBinding Opacity}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AUTHORIZE ACCESS" Foreground="{DynamicResource PureWhiteColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <Border BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="0,1,0,0" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryGreenColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="System Status: Online" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Emergency Contact" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextColor}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
