<Page x:Class="icpms_client.Pages.Auth.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:input="clr-namespace:icpms_client.UserControls.UI.Reusable.Inputs.Text"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      Loaded="LoginPage_OnLoaded"
      Title="LoginPage" Height="640" Width="420">

    <Page.Resources>
        <Style x:Key="AuthChipToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryChipTextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                CornerRadius="22"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource PrimaryBorderColor}"
                                Background="{DynamicResource SecondaryChipBackgroundColor}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PureWhiteColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource InputBorderFocusColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundColor}">
        <Border Width="360" CornerRadius="2" Background="{DynamicResource PrimaryWhiteColor}"
                BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True">
            <StackPanel Orientation="Vertical">

                <Border Background="{DynamicResource AuthHeaderBackgroundColor}" Padding="0,16,0,12">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="2" Background="{DynamicResource AuthHeaderAccentColor}"
                                HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="&#128737;" FontSize="18" Foreground="{DynamicResource PureWhiteColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="PARKING PRO" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PureWhiteColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="OPERATOR AUTHENTICATION" FontSize="10"
                                   Foreground="{DynamicResource AuthHeaderSubTextColor}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="14,12,14,14">
                    
                    <TextBlock Text="LOGIN METHOD" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="AuthMethodChips" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource AuthChipToggleButtonStyle}"
                                              Click="AuthMethodChip_OnClick"
                                              Tag="{Binding}"
                                              ToolTip="{Binding Label}"
                                              Margin="0,0,8,8">
                                    <fa:ImageAwesome Icon="{Binding Icon}" Width="16" Height="16"
                                                     Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AuthMethodStatusText"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               TextWrapping="Wrap"
                               Margin="0,-6,0,10"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="PasswordAuthPanel" Visibility="Collapsed">
                        <TextBlock Text="OPERATOR ID" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,4"/>
                        <input:FormTextField x:Name="LoginNameField"
                                              ShowErrorMessage="True"
                                              PlaceHolder="XXXX"
                                              BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                              Color="{DynamicResource PrimaryBlackColor}"
                                              RoundedRadius="2"
                                              BorderSize="1"
                                              FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                              ContentPadding="10,7"
                                              Margin="0,0,0,10"/>

                        <TextBlock Text="SECURITY KEY" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,4"/>
                        <input:FormPasswordField x:Name="PasswordField"
                                                  ShowErrorMessage="True"
                                                  PlaceHolder="••••••••"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}"
                                                  RoundedRadius="2"
                                                  BorderSize="1"
                                                  FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                                  ContentPadding="10,7"
                                                  Margin="0,0,0,14"/>
                    </StackPanel>

                    <StackPanel x:Name="DeviceAuthPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock x:Name="DeviceAuthLabel" Text="Present your credential to the reader"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,4"/>
                        <input:FormTextField x:Name="CredentialField"
                                              ShowErrorMessage="True"
                                              PlaceHolder="Waiting for device..."
                                              BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                              Color="{DynamicResource PrimaryBlackColor}"
                                              RoundedRadius="2"
                                              BorderSize="1"
                                              FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                              ContentPadding="10,7"/>
                    </StackPanel>

                    <StackPanel x:Name="PinAuthPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="ENTER 6-DIGIT PIN" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,4"/>
                        <UniformGrid Columns="6" Rows="1">
                            <input:FormTextField x:Name="Pin1" Length="1"
                                                  PlaceHolder="0"
                                                  FormTextAlignment="Center" TextFormatting="Number"
                                                  FontSize="18" FontWeight="Bold"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}"
                                                  RoundedRadius="2" BorderSize="1"
                                                  FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                                  ContentPadding="0,7" Margin="0,0,6,0"/>
                            <input:FormTextField x:Name="Pin2" Length="1"
                                                  PlaceHolder="0"
                                                  FormTextAlignment="Center" TextFormatting="Number"
                                                  FontSize="18" FontWeight="Bold"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}"
                                                  RoundedRadius="2" BorderSize="1"
                                                  FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                                  ContentPadding="0,7" Margin="0,0,6,0"/>
                            <input:FormTextField x:Name="Pin3" Length="1"
                                                  PlaceHolder="0"
                                                  FormTextAlignment="Center" TextFormatting="Number"
                                                  FontSize="18" FontWeight="Bold"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}"
                                                  RoundedRadius="2" BorderSize="1"
                                                  FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                                  ContentPadding="0,7" Margin="0,0,6,0"/>
                            <input:FormTextField x:Name="Pin4" Length="1"
                                                  PlaceHolder="0"
                                                  FormTextAlignment="Center" TextFormatting="Number"
                                                  FontSize="18" FontWeight="Bold"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}"
                                                  RoundedRadius="2" BorderSize="1"
                                                  FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                                  ContentPadding="0,7" Margin="0,0,6,0"/>
                            <input:FormTextField x:Name="Pin5" Length="1"
                                                  PlaceHolder="0"
                                                  FormTextAlignment="Center" TextFormatting="Number"
                                                  FontSize="18" FontWeight="Bold"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}"
                                                  RoundedRadius="2" BorderSize="1"
                                                  FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                                  ContentPadding="0,7" Margin="0,0,6,0"/>
                            <input:FormTextField x:Name="Pin6" Length="1"
                                                  PlaceHolder="0"
                                                  FormTextAlignment="Center" TextFormatting="Number"
                                                  FontSize="18" FontWeight="Bold"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}"
                                                  RoundedRadius="2" BorderSize="1"
                                                  FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                                  ContentPadding="0,7"/>
                        </UniformGrid>
                    </StackPanel>

                    <Button x:Name="LoginButton" Height="38"
                            Click="ButtonBase_OnClick"
                            Cursor="Hand"
                            IsEnabled="{Binding IsLoginEnabled, RelativeSource={RelativeSource AncestorType=Page}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource AuthHeaderBackgroundColor}" CornerRadius="2" Opacity="{TemplateBinding Opacity}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AUTHORIZE ACCESS" Foreground="{DynamicResource PureWhiteColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryGreenColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="System Status: Online" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Emergency Contact" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextColor}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>