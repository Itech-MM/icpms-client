<Page x:Class="icpms_client.Pages.Auth.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:icpms_client.Pages.Auth"
      xmlns:input="clr-namespace:icpms_client.UserControls.UI.Reusable.Inputs.Text"
      mc:Ignorable="d"
      Title="LoginPage" Height="580" Width="420">
    <Grid Background="{DynamicResource PrimaryBackgroundColor}">
        <Border Width="360" CornerRadius="2" Background="{DynamicResource PrimaryWhiteColor}"
                BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True">
            <StackPanel Orientation="Vertical">

                <!-- Header -->
                <Border Background="{DynamicResource AuthHeaderBackgroundColor}" Padding="0,16,0,12">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="2" Background="{DynamicResource AuthHeaderAccentColor}"
                                HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="&#128737;" FontSize="18" Foreground="{DynamicResource PureWhiteColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="PARKING PRO" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PureWhiteColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="OPERATOR AUTHENTICATION" FontSize="10"
                                   Foreground="{DynamicResource AuthHeaderSubTextColor}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Body -->
                <StackPanel Margin="14,12,14,14">
                    <TextBlock Text="Enter your credentials"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="OPERATOR ID" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,4"/>
                    <input:FormTextField x:Name="LoginNameField"
                                          ShowErrorMessage="True"
                                          PlaceHolder="XXXX"
                                          BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                          Color="{DynamicResource PrimaryBlackColor}"
                                          RoundedRadius="2"
                                          BorderSize="1"
                                          FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                          ContentPadding="10,7"
                                          Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="SECURITY KEY" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBlackColor}" HorizontalAlignment="Left"/>
                    </Grid>
                    <input:FormPasswordField x:Name="PasswordField"
                                              ShowErrorMessage="True"
                                              PlaceHolder="••••••••"
                                              BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                              Color="{DynamicResource PrimaryBlackColor}"
                                              RoundedRadius="2"
                                              BorderSize="1"
                                              FocusColor="{DynamicResource AuthHeaderBackgroundColor}"
                                              ContentPadding="10,7"
                                              Margin="0,0,0,14"/>

                    <Button x:Name="LoginButton" Height="38"
                            Click="ButtonBase_OnClick"
                            Cursor="Hand"
                            IsEnabled="{Binding IsLoginEnabled, RelativeSource={RelativeSource AncestorType=Page}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource AuthHeaderBackgroundColor}" CornerRadius="2" Opacity="{TemplateBinding Opacity}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AUTHORIZE ACCESS" Foreground="{DynamicResource PureWhiteColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <Border BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryGreenColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="System Status: Online" FontSize="10" Foreground="{DynamicResource SecondaryTextColor}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Emergency Contact" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextColor}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>