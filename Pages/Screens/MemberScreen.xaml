<UserControl x:Class="icpms_client.Pages.Screens.MemberScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:conv="clr-namespace:icpms_client.Common.Converters"
             xmlns:input="clr-namespace:icpms_client.UserControls.UI.Reusable.Inputs.Text"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1440">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <conv:TransactionAmountDisplayConverter x:Key="TransactionAmountDisplayConverter" />
        <conv:TransactionColorConverter x:Key="TransactionColorConverter" />
        <conv:NullableDecimalToStringConverter x:Key="NullableDecimalToStringConverter" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        
        <Style x:Key="AuthChipToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryChipTextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                CornerRadius="22"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource PrimaryBorderColor}"
                                Background="{DynamicResource SecondaryChipBackgroundColor}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PureWhiteColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource InputBorderFocusColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,10,10,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="lookup" Focusable="False">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Padding="14,10" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundColor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLookupTabActive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryDarkColor}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="4" Height="18" Margin="0,0,8,0" CornerRadius="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLookupTabActive}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock Text="Member Lookup" FontSize="14">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SmallTitleTextStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLookupTabActive}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PureWhiteColor}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="manage" Focusable="False">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Padding="14,10" CornerRadius="2" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundColor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsManageTabActive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryDarkColor}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="4" Height="18" Margin="0,0,8,0" CornerRadius="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsManageTabActive}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SecondaryAccentColor}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock Text="Register &amp; Manage" FontSize="14">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SmallTitleTextStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsManageTabActive}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PureWhiteColor}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Style="{DynamicResource DangerChipStyle}" Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsCurrentOperatorSupervisor, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                            <TextBlock Text="Approval Required" Style="{DynamicResource DangerChipTextStyle}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Style="{DynamicResource StatusPillStyle}" Margin="0,0,6,0" Background="{DynamicResource PrimaryColor}" Padding="12,8">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PureWhiteColor}" VerticalAlignment="Center">
                                <Run Text="Total " /><Run Text="{Binding TotalMembers, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource StatusPillStyle}" Margin="0,0,6,0" Background="{DynamicResource MutedButtonColor}" Padding="12,8">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PureWhiteColor}" VerticalAlignment="Center">
                                <Run Text="Regular " /><Run Text="{Binding RegularMembers, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource StatusPillStyle}" Margin="0,0,6,0" Background="{DynamicResource SecondaryAccentColor}" Padding="12,8">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PureWhiteColor}" VerticalAlignment="Center">
                                <Run Text="VIP " /><Run Text="{Binding VipMembers, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource StatusPillStyle}" Background="{DynamicResource PrimaryRedColor}" Padding="12,8">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PureWhiteColor}" VerticalAlignment="Center">
                                <Run Text="Expired " /><Run Text="{Binding ExpiredMembers, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Height="1" Margin="10,10,10,0" Background="{DynamicResource SecondaryBorderColor}" />

            <Grid Grid.Row="2" Margin="10">

                <Grid Visibility="{Binding IsLookupTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" MinWidth="320" />
                        <ColumnDefinition Width="1.4*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource ElevatedPanelStyle}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Search Members" Style="{DynamicResource SmallTitleTextStyle}" FontSize="15" Margin="0,0,0,8" />

                            <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Search" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                        Command="{Binding SearchMembersCommand}" Margin="6,0,0,0" Padding="10,4" />
                                <input:FormTextField Value="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                      PlaceHolder="Name or phone number"
                                                      ContentPadding="8,6"
                                                      BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}"
                                                      BorderSize="1.2" />
                            </DockPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="2"
                                                                            Padding="10" Margin="0,0,0,6" Cursor="Hand">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.85" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                                        <TextBlock Text="{Binding PhoneNumber}" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" />
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right" Style="{DynamicResource VipChipStyle}" VerticalAlignment="Center"
                                                            Visibility="{Binding IsVip, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="VIP" Style="{DynamicResource VipChipTextStyle}" />
                                                    </Border>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ElevatedPanelStyle}">
                        <Grid Margin="12">
                            <TextBlock Text="Select a member from the list" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       Visibility="{Binding SelectedMember, Converter={StaticResource NullToVisibilityConverter}}" />

                            <StackPanel Visibility="{Binding SelectedMember, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedMember.Name}" Style="{DynamicResource SmallTitleTextStyle}" FontSize="16" />
                                        <Border Style="{DynamicResource VipChipStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedMember.IsVip, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="VIP" Style="{DynamicResource VipChipTextStyle}" />
                                        </Border>
                                        <Border Style="{DynamicResource DangerChipStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedMember.IsExpired, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Expired" Style="{DynamicResource DangerChipTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding SelectedMember.PhoneNumber}" FontSize="12.5" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SelectedMember.Email}" FontSize="12.5" Margin="0,0,0,10"
                                           Foreground="{DynamicResource SecondaryTextColor}" />

                                <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="2" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Subscription" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                        <TextBlock Text="No active subscription" FontSize="12" Foreground="{DynamicResource SecondaryTextColor}"
                                                   Visibility="{Binding SelectedSubscription, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <StackPanel Visibility="{Binding SelectedSubscription, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                            <TextBlock FontSize="12"><Run Text="Plan: " /><Run Text="{Binding SelectedSubscription.PlanName}" /></TextBlock>
                                            <TextBlock FontSize="12"><Run Text="Status: " /><Run Text="{Binding SelectedSubscription.StatusDesc}" /></TextBlock>
                                            <TextBlock FontSize="12"><Run Text="Valid: " /><Run Text="{Binding SelectedSubscription.StartDateDesc}" /><Run Text=" - " /><Run Text="{Binding SelectedSubscription.EndDateDesc}" /></TextBlock>
                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" Margin="0,4,0,0">
                                                <Run Text="Balance: " /><Run Text="{Binding SelectedSubscription.Balance}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Transaction History" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TransactionHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="2" Padding="8" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding TransactionTypeDesc}" FontSize="11.5" />
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding Converter={StaticResource TransactionAmountDisplayConverter}}"
                                                                       FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding Converter={StaticResource TransactionColorConverter}}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Remark}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource SecondaryTextColor}"
                                                                   Visibility="{Binding Remark, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsManageTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource ElevatedPanelStyle}">
                        <StackPanel Margin="14">
                            <TextBlock Text="Register New Member" Style="{DynamicResource SmallTitleTextStyle}" FontSize="15" Margin="0,0,0,10" />

                            <TextBlock Text="Name" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <input:FormTextField Value="{Binding NewMemberName, UpdateSourceTrigger=PropertyChanged}"
                                                  ContentPadding="8,6" Margin="0,0,0,8"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />

                            <TextBlock Text="Phone Number" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <input:FormTextField Value="{Binding NewMemberPhone, UpdateSourceTrigger=PropertyChanged}"
                                                  ContentPadding="8,6" Margin="0,0,0,8"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />

                            <TextBlock Text="Email" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <input:FormTextField Value="{Binding NewMemberEmail, UpdateSourceTrigger=PropertyChanged}"
                                                  ContentPadding="8,6" Margin="0,0,0,10"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />

                            <CheckBox Content="VIP Member" IsChecked="{Binding NewMemberIsVip}" Margin="0,0,0,14" FontSize="12.5" />

                            <TextBlock Text="Vehicles" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="0.4*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <input:FormTextField Grid.Column="0"
                                                     Value="{Binding NewVehiclePlateNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceHolder="Plate number" ContentPadding="8,6" Margin="0,0,6,0"
                                                     BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                     Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />

                                <input:FormTextField Grid.Column="1"
                                                     Value="{Binding NewVehicleType, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceHolder="Type (e.g. Car)" ContentPadding="8,6" Margin="0,0,6,0"
                                                     BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                     Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />

                                <Button Grid.Column="2" Content="Add" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                        Command="{Binding AddVehicleCommand}" Padding="10,6" />
                            </Grid>

                        <ItemsControl ItemsSource="{Binding NewMemberVehicles}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="12"
                                            Padding="10,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PlateNumber}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding VehicleType, StringFormat=' · {0}'}" FontSize="10.5"
                                                       Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />
                                            <Button Command="{Binding DataContext.RemoveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="6,0,0,0" Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryRedColor}" />
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <fa:FontAwesome Icon="Close" FontSize="9" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="At least one vehicle is required." FontSize="10.5" Foreground="{DynamicResource PrimaryRedColor}"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding NewMemberVehicles.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />

                            <Button Content="Register Member" Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding RegisterMemberCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ElevatedPanelStyle}">
                        <StackPanel Margin="14">
                            <TextBlock Text="Subscription Actions" Style="{DynamicResource SmallTitleTextStyle}" FontSize="15" Margin="0,0,0,10" />

                            <TextBlock Text="Select a member in Member Lookup first" FontSize="12" Foreground="{DynamicResource SecondaryTextColor}"
                                       Visibility="{Binding SelectedMember, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding SelectedMember.Name}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"
                                       Visibility="{Binding SelectedMember, Converter={StaticResource InverseNullToVisibilityConverter}}" />

                            <TextBlock Text="Subscribe to Plan" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <input:FormComboBoxField Items="{Binding ActivePlanOptions}"
                                                      Selected="{Binding SelectedPlanOption, Mode=TwoWay}"
                                                      PlaceHolder="Select a plan"
                                                      ContentPadding="8,6" Margin="0,0,0,6"
                                                      BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />
                            <Button Content="Subscribe" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                    Command="{Binding SubscribeCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,14" />

                            <Border Height="1" Background="{DynamicResource SecondaryBorderColor}" Margin="0,0,0,14" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Renew Subscription" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                        Command="{Binding RenewCommand}" Padding="10,6" Margin="0,0,6,0" />
                                <Button Content="Cancel Subscription" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                        Command="{Binding CancelSubscriptionCommand}" Padding="10,6" />
                            </StackPanel>

                            <TextBlock Text="Top Up Balance" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Top Up" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                        Command="{Binding TopUpCommand}" Margin="6,0,0,0" Padding="10,6" />
                                <input:FormTextField Value="{Binding TopUpAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDecimalToStringConverter}}"
                                                     TextFormatting="Number"
                                                     PlaceHolder="Amount" ContentPadding="8,6"
                                                     BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                     Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />
                            </DockPanel>
                            <input:FormTextArea Value="{Binding TopUpRemark, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceHolder="Remark" InputHeight="50" ContentPadding="8,6"
                                                 BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                 Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#CC000000"
                    Visibility="{Binding IsSupervisorModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    d:DesignHeight="0">
                <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="3"
                        BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1"
                        Padding="16" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="This action requires a supervisor to confirm." FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="VERIFICATION METHOD" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBlackColor}" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="SupervisorAuthMethodChips" Margin="0,0,0,10" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource AuthChipToggleButtonStyle}"
                                                  Click="SupervisorAuthMethodChip_OnClick"
                                                  Tag="{Binding}"
                                                  ToolTip="{Binding Label}"
                                                  Margin="0,0,8,8">
                                        <fa:ImageAwesome Icon="{Binding Icon}" Width="16" Height="16"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="SupervisorPasswordAuthPanel" Visibility="Collapsed">
                            <TextBlock Text="Supervisor Username" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <input:FormTextField x:Name="SupervisorUsernameField"
                                                  ContentPadding="8,6" Margin="0,0,0,8"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />

                            <TextBlock Text="Supervisor Password" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <input:FormPasswordField x:Name="SupervisorPasswordField"
                                                      ContentPadding="8,6" Margin="0,0,0,14"
                                                      BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />
                        </StackPanel>

                        <StackPanel x:Name="SupervisorDeviceAuthPanel" Visibility="Collapsed" Margin="0,0,0,14">
                            <TextBlock x:Name="SupervisorDeviceAuthLabel" Text="Present supervisor credential to the reader"
                                       FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <input:FormTextField x:Name="SupervisorCredentialField"
                                                  PlaceHolder="Waiting for device..."
                                                  ContentPadding="8,6"
                                                  BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                  Color="{DynamicResource PrimaryBlackColor}" BorderSize="1.2" />
                        </StackPanel>

                        <StackPanel x:Name="SupervisorPinAuthPanel" Visibility="Collapsed" Margin="0,0,0,14">
                            <TextBlock Text="ENTER 6-DIGIT PIN" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <UniformGrid Columns="6" Rows="1">
                                <input:FormTextField x:Name="SupPin1" Length="1" PlaceHolder="0" FormTextAlignment="Center" TextFormatting="Number"
                                                      FontSize="18" FontWeight="Bold" BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1" ContentPadding="0,7" Margin="0,0,6,0"/>
                                <input:FormTextField x:Name="SupPin2" Length="1" PlaceHolder="0" FormTextAlignment="Center" TextFormatting="Number"
                                                      FontSize="18" FontWeight="Bold" BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1" ContentPadding="0,7" Margin="0,0,6,0"/>
                                <input:FormTextField x:Name="SupPin3" Length="1" PlaceHolder="0" FormTextAlignment="Center" TextFormatting="Number"
                                                      FontSize="18" FontWeight="Bold" BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1" ContentPadding="0,7" Margin="0,0,6,0"/>
                                <input:FormTextField x:Name="SupPin4" Length="1" PlaceHolder="0" FormTextAlignment="Center" TextFormatting="Number"
                                                      FontSize="18" FontWeight="Bold" BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1" ContentPadding="0,7" Margin="0,0,6,0"/>
                                <input:FormTextField x:Name="SupPin5" Length="1" PlaceHolder="0" FormTextAlignment="Center" TextFormatting="Number"
                                                      FontSize="18" FontWeight="Bold" BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1" ContentPadding="0,7" Margin="0,0,6,0"/>
                                <input:FormTextField x:Name="SupPin6" Length="1" PlaceHolder="0" FormTextAlignment="Center" TextFormatting="Number"
                                                      FontSize="18" FontWeight="Bold" BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                                      Color="{DynamicResource PrimaryBlackColor}" BorderSize="1" ContentPadding="0,7"/>
                            </UniformGrid>
                        </StackPanel>

                        <DockPanel LastChildFill="True">
                            <Button Content="Cancel" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                    Command="{Binding CancelSupervisorApprovalCommand}" Width="110" DockPanel.Dock="Left" />
                            <Button x:Name="ConfirmSupervisorButton" Content="Confirm" Style="{DynamicResource PrimaryButtonStyle}"
                                    Click="ConfirmSupervisorButton_OnClick"
                                    HorizontalAlignment="Stretch" Margin="8,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>