<UserControl x:Class="icpms_client.Pages.Screens.Sections.HomeShiftSummarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:icpms_client.Common.Converters"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>

        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundColor}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="StatIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource PrimaryChipBackgroundColor}" />
        </Style>

    </UserControl.Resources>
    <Border Padding="8" Background="{DynamicResource PrimaryDarkColor}"
        CornerRadius="2" BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Shift Summary" Style="{DynamicResource SmallTitleTextStyle}" FontSize="13"
                   Foreground="{DynamicResource PureWhiteColor}" />

        <Grid Grid.Row="1" Margin="0,2,0,6">
            <TextBlock Text="{Binding ShiftSubtitle}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <Border Style="{StaticResource SkeletonShimmerStyle}"
                    Height="12" Width="90" HorizontalAlignment="Left"
                    Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    d:DesignHeight="0"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,3,0" Style="{StaticResource StatTileStyle}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Style="{StaticResource StatIconBadgeStyle}" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="SignIn" Width="9" Height="9"
                                              Foreground="{DynamicResource PrimaryChipTextColor}" />
                        </Border>
                        <TextBlock Text="{Binding VehiclesIn}" FontWeight="Bold" FontSize="15" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonShimmerStyle}"
                            Height="50"
                            Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="3,0,3,0" Style="{StaticResource StatTileStyle}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Style="{StaticResource StatIconBadgeStyle}" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="SignOut" Width="9" Height="9"
                                              Foreground="{DynamicResource PrimaryChipTextColor}" />
                        </Border>
                        <TextBlock Text="{Binding VehiclesOut}" FontWeight="Bold" FontSize="15" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonShimmerStyle}"
                            Height="50"
                            Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="3,0,0,0" Style="{StaticResource StatTileStyle}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Style="{StaticResource StatIconBadgeStyle}" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="Car" Width="9" Height="9"
                                              Foreground="{DynamicResource PrimaryChipTextColor}" />
                        </Border>
                        <TextBlock Text="{Binding CurrentlyParked}" FontWeight="Bold" FontSize="15" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonShimmerStyle}"
                            Height="50"
                            Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
        </Grid>
        
        <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,6" CornerRadius="2"
                Background="{DynamicResource SecondaryBackgroundColor}">
            <Grid>
                <Grid Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="2"
                            Background="{DynamicResource PrimaryGreenColor}" Opacity="0.18" />
                    <fa:ImageAwesome Grid.Column="0" Icon="Money" Width="11" Height="11"
                                      Foreground="{DynamicResource PrimaryGreenColor}" />

                    <TextBlock Grid.Column="1" Text="Revenue collected" FontSize="10.5"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{DynamicResource SecondaryTextColor}" />

                    <TextBlock Grid.Column="2" Text="{Binding RevenueCollectedText}" FontWeight="Bold" FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryGreenColor}" />
                </Grid>

                <Border Style="{StaticResource SkeletonShimmerStyle}"
                        Height="24"
                        Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        d:DesignHeight="0"/>
            </Grid>
        </Border>
    </Grid>
</Border>
</UserControl>