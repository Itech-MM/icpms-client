<UserControl x:Class="icpms_client.Pages.Screens.Sections.HomeShiftSummarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:icpms_client.Common.Converters"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>

        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundColor}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,10" />
        </Style>

        <Style x:Key="StatIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource PrimaryChipBackgroundColor}" />
        </Style>

    </UserControl.Resources>
    <Border Padding="18" Background="{DynamicResource PrimaryDarkColor}"
            CornerRadius="10" BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1">
        <StackPanel>

            <TextBlock Text="Shift Summary" Style="{DynamicResource SmallTitleTextStyle}" FontSize="13"
                       Foreground="{DynamicResource PureWhiteColor}" />
            <Grid Margin="0,4,0,16">
                <TextBlock Text="{Binding ShiftSubtitle}" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <Border Style="{StaticResource SkeletonShimmerStyle}"
                        Height="12" Width="90" HorizontalAlignment="Left"
                        Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        d:DesignHeight="0"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource StatTileStyle}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Border Style="{StaticResource StatIconBadgeStyle}" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="SignIn" Width="11" Height="11"
                                                  Foreground="{DynamicResource PrimaryChipTextColor}" />
                            </Border>
                            <TextBlock Text="{Binding VehiclesIn}" FontWeight="Bold" FontSize="17" Margin="0,8,0,2"
                                       
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonShimmerStyle}"
                                Height="66"
                                Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="5,0,5,0" Style="{StaticResource StatTileStyle}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Border Style="{StaticResource StatIconBadgeStyle}" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="SignOut" Width="11" Height="11"
                                                  Foreground="{DynamicResource PrimaryChipTextColor}" />
                            </Border>
                            <TextBlock Text="{Binding VehiclesOut}" FontWeight="Bold" FontSize="17" Margin="0,8,0,2"
                                       
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonShimmerStyle}"
                                Height="66"
                                Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource StatTileStyle}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Border Style="{StaticResource StatIconBadgeStyle}" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Car" Width="11" Height="11"
                                                  Foreground="{DynamicResource PrimaryChipTextColor}" />
                            </Border>
                            <TextBlock Text="{Binding CurrentlyParked}" FontWeight="Bold" FontSize="17" Margin="0,8,0,2"
                                      
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonShimmerStyle}"
                                Height="66"
                                Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource SecondaryBackgroundColor}">
                <Grid>
                    <Grid Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                Background="{DynamicResource PrimaryGreenColor}" Opacity="0.18" />
                        <fa:ImageAwesome Grid.Column="0" Icon="Money" Width="13" Height="13"
                                          Foreground="{DynamicResource PrimaryGreenColor}" />

                        <TextBlock Grid.Column="1" Text="Revenue collected" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource SecondaryTextColor}" />

                        <TextBlock Grid.Column="2" Text="{Binding RevenueCollectedText}" FontWeight="Bold" FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryGreenColor}" />
                    </Grid>

                    <Border Style="{StaticResource SkeletonShimmerStyle}"
                            Height="30"
                            Visibility="{Binding IsShiftSummaryLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            d:DesignHeight="0"/>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>