<UserControl x:Class="icpms_client.Pages.Screens.Sections.HomeParkingAreaSummarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:icpms_client.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>

        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <Style x:Key="CapacityAccentTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AreaCapacityStatus}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AreaCapacityStatus}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryRedColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CapacityAccentProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AreaCapacityStatus}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AreaCapacityStatus}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryRedColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    <Border Padding="10" Background="{DynamicResource SecondaryBackgroundColor}"
            CornerRadius="2" BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Parking Area Summary" Style="{DynamicResource SmallTitleTextStyle}" FontSize="13" />

            <Grid Margin="0,6,0,4">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsParkingAreaLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding AreaCapacityPercentage, StringFormat={}{0}%}" FontSize="30" FontWeight="Bold"
                               Style="{StaticResource CapacityAccentTextStyle}" />
                    <TextBlock Text="{Binding TotalSlotSummaryText}" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Bottom" Foreground="{DynamicResource SecondaryTextColor}" />
                </StackPanel>

                <Border Style="{StaticResource SkeletonShimmerStyle}"
                        Height="26" HorizontalAlignment="Left" Width="120"
                        Visibility="{Binding IsParkingAreaLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <StackPanel Margin="0,6,0,0">

                <Grid Margin="0,0,0,6">
                    <StackPanel Visibility="{Binding IsParkingAreaLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Normal" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextColor}" />
                            <TextBlock Grid.Column="1" Text="{Binding NormalSlotSummaryText}" FontSize="11.5" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="{Binding NormalSlot}" Value="{Binding OccupiedNormalSlot, Mode=OneWay}"
                                     Height="5" Margin="0,4,0,0" BorderThickness="0"
                                     Style="{StaticResource CapacityAccentProgressBarStyle}"
                                     Background="{DynamicResource PrimaryBackgroundColor}" />
                    </StackPanel>

                    <Border Style="{StaticResource SkeletonShimmerStyle}"
                            Height="30"
                            Visibility="{Binding IsParkingAreaLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <StackPanel Visibility="{Binding IsParkingAreaLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VIP" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextColor}" />
                            <TextBlock Grid.Column="1" Text="{Binding VipSlotSummaryText}" FontSize="11.5" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="{Binding VipSlot}" Value="{Binding OccupiedVipSlot, Mode=OneWay}"
                                     Height="5" Margin="0,4,0,0" BorderThickness="0"
                                     Style="{StaticResource CapacityAccentProgressBarStyle}"
                                     Background="{DynamicResource PrimaryBackgroundColor}" />
                    </StackPanel>

                    <Border Style="{StaticResource SkeletonShimmerStyle}"
                            Height="30"
                            Visibility="{Binding IsParkingAreaLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>