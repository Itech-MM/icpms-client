<UserControl x:Class="icpms_client.Pages.Screens.Sections.RecentVisitorsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:icpms_client.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:BooleanAndToVisibilityConverter x:Key="BoolAndToVisibilityConverter" />

        <!-- Shared column layout so header + rows always line up -->
        <Style x:Key="TableColumnDividerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource TableBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ElevatedPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Recent Visitors" Style="{DynamicResource SmallTitleTextStyle}"
                       FontSize="15" Margin="10,10,10,10" />

            <!-- Outer table frame: solid border around the whole table -->
            <Border Grid.Row="1" Grid.RowSpan="2" Margin="10,0,10,10"
                    BorderBrush="{DynamicResource TableBorder}" BorderThickness="1" CornerRadius="6"
                    Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header row: shaded fill + solid bottom border to separate from body -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource TableColumnHeader}"
                            BorderBrush="{DynamicResource TableBorder}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TableColumnDividerStyle}">
                                <TextBlock Text="PLATE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextColor}" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TableColumnDividerStyle}">
                                <TextBlock Text="GATE" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextColor}" />
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TableColumnDividerStyle}">
                                <TextBlock Text="TIME" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextColor}" />
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource TableColumnDividerStyle}">
                                <TextBlock Text="TYPE" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextColor}" />
                            </Border>
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"
                                       Foreground="{DynamicResource SecondaryTextColor}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">

                        <!-- Skeleton loading state: 6 mockup rows, shown only on first load -->
                        <StackPanel Visibility="{Binding IsInitialLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding SkeletonRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource TableBorder}" BorderThickness="0,0,0,1">
                                            <Grid Margin="12,8" Height="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource SkeletonShimmerStyle}"
                                                        Height="14" Width="70" HorizontalAlignment="Left" />
                                                <Border Grid.Column="1" Style="{StaticResource SkeletonShimmerStyle}"
                                                        Height="14" Width="55" HorizontalAlignment="Left" />
                                                <Border Grid.Column="2" Style="{StaticResource SkeletonShimmerStyle}"
                                                        Height="14" Width="50" HorizontalAlignment="Left" />
                                                <Border Grid.Column="3" Style="{StaticResource SkeletonShimmerStyle}"
                                                        Height="14" Width="50" HorizontalAlignment="Left" />
                                                <Border Grid.Column="4" Style="{StaticResource SkeletonShimmerStyle}"
                                                        Height="14" Width="60" HorizontalAlignment="Left" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Empty state -->
                        <TextBlock Text="No recent visitors" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Real data -->
                        <ScrollViewer x:Name="VisitorsScrollViewer" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="VisitorsScrollViewer_OnScrollChanged">
                            <ScrollViewer.Visibility>
                                <MultiBinding Converter="{StaticResource BoolAndToVisibilityConverter}">
                                    <Binding Path="IsInitialLoading" Converter="{StaticResource InverseBoolConverter}" />
                                    <Binding Path="HasNoData" Converter="{StaticResource InverseBoolConverter}" />
                                </MultiBinding>
                            </ScrollViewer.Visibility>

                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Visitors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Solid row border (bottom divider) with fill for unknown-plate rows -->
                                            <Border Padding="12,8" BorderBrush="{DynamicResource TableBorder}" BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnknownPlate}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerChipBackgroundColor}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PlateNumber}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBlackColor}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding GateName}" FontSize="11.5" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11.5" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource MemberChipStyle}" Margin="0,0,4,0"
                                                                Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="MEMBER" Style="{StaticResource MemberChipTextStyle}" />
                                                        </Border>
                                                        <Border Style="{StaticResource VipChipStyle}"
                                                                Visibility="{Binding IsVip, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="VIP" Style="{StaticResource VipChipTextStyle}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="4" Text="{Binding StatusDesc}" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8"
                                            Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Loading more..." FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextColor}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
