<UserControl x:Class="icpms_client.Pages.Screens.HomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:icpms_client.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1440">

    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="GateStateBrushConverter"
                                    TrueBrush="{StaticResource PrimaryGreenColor}"
                                    FalseBrush="{StaticResource MutedButtonColor}" />
        <conv:BoolToBrushConverter x:Key="VisitorStateBrushConverter"
                                    TrueBrush="{StaticResource PrimaryGreenLighterColor}"
                                    FalseBrush="{StaticResource SecondaryBackgroundColor}" />
    </UserControl.Resources>

    <Border Padding="14" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- header -->
                <RowDefinition Height="2*" />
                <!-- entrance / exit lanes -->
                <RowDefinition Height="Auto" />
                <!-- spacer -->
                <RowDefinition Height="1.1*" />
                <!-- parking / shift / recent visitors -->
            </Grid.RowDefinitions>

            <!-- ======================= HEADER ======================= -->
            <!--<Border Grid.Row="0" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="5"
                    Padding="16,12" Margin="0,0,0,10">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                        <TextBlock Text="Gate Control" Style="{DynamicResource TitleTextStyle}" />
                        <TextBlock Text="North Lot Terminal · Entrance &amp; Exit lanes"
                                   Foreground="{DynamicResource SecondaryTextColor}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        ~1~ Shift status pill: bind Background/Text via a converter, or two pills swapped by Visibility @1@
                        <Border Style="{DynamicResource StatusPillStyle}"
                                Background="{DynamicResource PrimaryGreenLighterColor}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ShiftStatusText}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryGreenColor}" />
                        </Border>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PrimaryDarkColor}">
                            <TextBlock Text="{Binding OperatorInitials}" Foreground="{DynamicResource PureWhiteColor}"
                                       FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>-->

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,5,0" Padding="14" Background="{DynamicResource PrimaryBackgroundColor}"
                        CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="145" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="Enterance Lane" Style="{DynamicResource SmallTitleTextStyle}" FontSize="14" />
                                <Border Background="{DynamicResource PrimaryGreenLighterColor}" CornerRadius="5" Padding="8,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Auto" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryGreenColor}" />
                                </Border>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Style="{DynamicResource StatusPillStyle}"
                                    Background="{Binding ExitGateOpen, Converter={StaticResource GateStateBrushConverter}}">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PureWhiteColor}"
                                           Text="{Binding ExitGateStateText}" />
                            </Border>
                        </DockPanel>

                        <!-- ANPR + CCTV feeds -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CAM-03 : Exit ANPR -->
                            <Border Grid.Column="0" Margin="0,0,5,0" Background="{DynamicResource PrimaryDarkColor}"
                                    CornerRadius="5" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding ExitAnprFrame}" Stretch="UniformToFill" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="8">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryRedColor}"
                                                 Margin="0,0,5,0" />
                                        <TextBlock Text="CAM-01 · ANPR" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource PureWhiteColor}" />
                                    </StackPanel>
                                    
                                </Grid>
                            </Border>

                            <!-- CAM-04 : Exit CCTV -->
                            <Border Grid.Column="1" Margin="5,0,0,0" Background="{DynamicResource PrimaryDarkColor}"
                                    CornerRadius="5" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding ExitCctvFrame}" Stretch="UniformToFill" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="8">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryRedColor}"
                                                 Margin="0,0,5,0" />
                                        <TextBlock Text="CAM-02 · CCTV" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource PureWhiteColor}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        
                        <!-- Payment / gate control panel: only visible once a plate is matched at exit -->
                        <Border Grid.Row="3" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="5"
                                Padding="12"
                                Visibility="{Binding ExitPlateMatched, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Margin="0,0,0,10" Background="{DynamicResource SecondaryBorderColor}" CornerRadius="5" Padding="14,8"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="1A/1234"
                                                    Style="{DynamicResource TitleTextStyle}" Foreground="{DynamicResource PrimaryWhiteColor}" />
                                    </Border>
                                </Grid>
                                <Border Margin="0,0,0,10" Background="{DynamicResource PrimaryGreenLighterColor}" CornerRadius="5" Padding="8,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="VIP" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryGreenColor}" />
                                </Border>
                                
                                <!-- Step 2 : choose method -->
                                

                                <!-- Step 3 : confirm -->
                                <DockPanel LastChildFill="False">
                                    
                                    
                                    <!-- Step 4 : open gate (only once paid) -->
                                    <Button Content="Open Gate" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                            Command="{Binding OpenExitGateCommand}" HorizontalAlignment="Stretch"
                                            Margin="0,8,8,0"/>
                                    <Button Content="Manual Entry" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                            Command="{Binding ConfirmPaymentCommand}" HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding IsReadyToConfirmPayment, Converter={StaticResource BoolToVisibilityConverter}}" />

                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="5,0,0,0" Padding="14" Background="{DynamicResource PrimaryBackgroundColor}"
                        CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="145" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="Exit Lane" Style="{DynamicResource SmallTitleTextStyle}" FontSize="14" />
                                <Border Background="#FFE3E3" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="MANUAL" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryRedColor}" />
                                </Border>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Style="{DynamicResource StatusPillStyle}"
                                    Background="{Binding ExitGateOpen, Converter={StaticResource GateStateBrushConverter}}">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PureWhiteColor}"
                                           Text="{Binding ExitGateStateText}" />
                            </Border>
                        </DockPanel>

                        <!-- ANPR + CCTV feeds -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CAM-03 : Exit ANPR -->
                            <Border Grid.Column="0" Margin="0,0,5,0" Background="{DynamicResource PrimaryDarkColor}"
                                    CornerRadius="5" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding ExitAnprFrame}" Stretch="UniformToFill" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="8">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryRedColor}"
                                                 Margin="0,0,5,0" />
                                        <TextBlock Text="CAM-03 · ANPR" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource PureWhiteColor}" />
                                    </StackPanel>
                                    
                                </Grid>
                            </Border>

                            <!-- CAM-04 : Exit CCTV -->
                            <Border Grid.Column="1" Margin="5,0,0,0" Background="{DynamicResource PrimaryDarkColor}"
                                    CornerRadius="5" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding ExitCctvFrame}" Stretch="UniformToFill" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="8">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryRedColor}"
                                                 Margin="0,0,5,0" />
                                        <TextBlock Text="CAM-04 · CCTV" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource PureWhiteColor}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2" Margin="0,10,0,10" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Text="{Binding ExitStatusText}" />

                        <!-- Payment / gate control panel: only visible once a plate is matched at exit -->
                        <Border Grid.Row="3" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="5"
                                Padding="12"
                                Visibility="{Binding ExitPlateMatched, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Parked duration" FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextColor}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ExitParkedDurationText}" FontWeight="Bold"
                                               FontSize="11.5" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fee due" FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextColor}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ExitFeeDueText}" FontWeight="Bold"
                                               FontSize="15" Foreground="{DynamicResource PrimaryColor}" />
                                </Grid>
                                
                                <!-- Step 2 : choose method -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsChoosingPaymentMethod, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Card" Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding SelectCardPaymentCommand}" Width="90" Margin="0,0,8,0" />
                                    <Button Content="Cash" Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding SelectCashPaymentCommand}" Width="90" />
                                </StackPanel>

                                <!-- Step 3 : confirm -->
                                <DockPanel LastChildFill="True">
                                    
                                    
                                    <!-- Step 4 : open gate (only once paid) -->
                                    <Button Content="Open Gate" Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding OpenExitGateCommand}" HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding IsPaymentComplete, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="Confirm Payment" Style="{DynamicResource InfoButtonStyle}"
                                            Command="{Binding ConfirmPaymentCommand}" HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding IsReadyToConfirmPayment, Converter={StaticResource BoolToVisibilityConverter}}" />

                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Height="10" Background="Transparent" />

            <!-- ======================= SUMMARY ROW ======================= -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,5,0" Padding="14" Background="{DynamicResource PrimaryBackgroundColor}"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Parking Area Summary" Style="{DynamicResource SmallTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBlock Text="{Binding OccupancyPercentText}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryColor}" />
                            <TextBlock Text="{Binding OccupancyFractionText}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Bottom" Foreground="{DynamicResource SecondaryTextColor}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Zones}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextColor}" />
                                            <TextBlock Grid.Column="1" Text="{Binding OccupiedLabel}" FontSize="11"
                                                       FontWeight="Bold" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Occupied}"
                                                     Height="6" Margin="0,4,0,0" BorderThickness="0"
                                                     Foreground="{DynamicResource PrimaryColor}"
                                                     Background="{DynamicResource SecondaryBackgroundColor}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="5,0,5,0" Padding="14" Background="{DynamicResource PrimaryBackgroundColor}"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Shift Summary" Style="{DynamicResource SmallTitleTextStyle}" />
                        <TextBlock Text="{Binding OperatorShiftLabel}" FontSize="11" Margin="0,8,0,10"
                                   Foreground="{DynamicResource SecondaryTextColor}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vehicles in" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextColor}" />
                            <TextBlock Grid.Column="1" Text="{Binding VehiclesIn}" FontWeight="Bold" FontSize="12.5" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vehicles out" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextColor}" />
                            <TextBlock Grid.Column="1" Text="{Binding VehiclesOut}" FontWeight="Bold" FontSize="12.5" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Currently parked" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextColor}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentlyParked}" FontWeight="Bold" FontSize="12.5" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Revenue collected" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextColor}" />
                            <TextBlock Grid.Column="1" Text="{Binding RevenueCollectedText}" FontWeight="Bold"
                                       FontSize="12.5" Foreground="{DynamicResource PrimaryGreenColor}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="5,0,0,0" Background="{DynamicResource PrimaryBackgroundColor}"
                        CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Recent Visitors" Style="{DynamicResource SmallTitleTextStyle}"
                                   Margin="14,12,14,6" />

                        <DataGrid Grid.Row="1" Style="{DynamicResource TableDataGridStyle}" Margin="10,0,10,10"
                                  ItemsSource="{Binding RecentVisitors}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Plate" Binding="{Binding Plate}" Width="*" />
                                <DataGridTextColumn Header="Gate" Binding="{Binding Gate}" Width="*" />
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource StatusPillStyle}"
                                                    Background="{Binding IsInside, Converter={StaticResource VisitorStateBrushConverter}}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
