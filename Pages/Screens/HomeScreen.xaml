<UserControl x:Class="icpms_client.Pages.Screens.HomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:icpms_client.Common.Converters"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:sections="clr-namespace:icpms_client.Pages.Screens.Sections"
             xmlns:input="clr-namespace:icpms_client.UserControls.UI.Reusable.Inputs.Text"
             xmlns:player="clr-namespace:FlexiStream.Player;assembly=FlexiStream.Player"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1440">

    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="GateStateBrushConverter"
                                    TrueBrush="{StaticResource PrimaryGreenColor}"
                                    FalseBrush="{StaticResource MutedButtonColor}" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:BoolToCursorConverter x:Key="BoolToCursorConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundColor}">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"  />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height=".7*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*" MinWidth="180" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Margin="0,0,0,4">
                                    <sections:HomeParkingAreaSummarySection x:Name="ParkingSection"/>
                                </Border>

                                <Border Grid.Row="1" Margin="0,4,0,0">
                                    <sections:HomeShiftSummarySection x:Name="ShiftSummarySection"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Margin="4,0,4,0" Style="{StaticResource ElevatedPanelStyle}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="110" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LaneAccentBarStyle}" Height="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Entrance Lane" Style="{DynamicResource SmallTitleTextStyle}" FontSize="15" />
                                        <Border Style="{DynamicResource SuccessChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Auto" Style="{DynamicResource SuccessChipTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryOutlineButtonStyle}" Content="Clear" 
                                                Padding="6,4"
                                                Command="{Binding TestEntranceEntryCommand}" Margin="0,0,6,0"/>
                                        <Border Style="{DynamicResource StatusPillStyle}" VerticalAlignment="Center"
                                                Background="{Binding EntranceGateOpen, Converter={StaticResource GateStateBrushConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LiveDotStyle}" Fill="{DynamicResource PureWhiteColor}" Margin="0,0,4,0"/>
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PureWhiteColor}"
                                                           Text="{Binding EntranceGateStateText}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Margin="6,0,0,0" Command="{Binding RefreshEntranceCameraCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <fa:FontAwesome Icon="Refresh" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Margin="0,0,3,0" Background="{DynamicResource PrimaryDarkColor}"
                                            CornerRadius="2" ClipToBounds="True">
                                        <Grid>
                                            <player:RtspStreamPlayer x:Name="EntranceAnprControl"
                                                            Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Margin="6"
                                                        Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Ellipse Style="{StaticResource LiveDotStyle}" Fill="{DynamicResource PrimaryRedColor}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding EntranceAnprName}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PureWhiteColor}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource SkeletonShimmerStyle}"
                                                    Visibility="{Binding IsPreloadLoading, Converter={StaticResource BoolToVisibilityConverter}}" 
                                                    d:DesignHeight="0" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Margin="3,0,0,0" Background="{DynamicResource PrimaryDarkColor}"
                                            CornerRadius="2" ClipToBounds="True">
                                        <Grid>
                                            <player:RtspStreamPlayer x:Name="EntranceCctvControl"
                                                                     Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Margin="6"
                                                        Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Ellipse Style="{StaticResource LiveDotStyle}" Fill="{DynamicResource PrimaryRedColor}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding EntranceCctvName}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PureWhiteColor}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource SkeletonShimmerStyle}"
                                                    Visibility="{Binding IsPreloadLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Margin="0,6,0,6" FontSize="11.5" Opacity="0" Text=" " />

                                <Border Grid.Row="3" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="2" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <Button Command="{Binding OpenEntrancePlateSearchCommand}"
                                                        IsEnabled="{Binding EntranceHasUnknownPlate}"
                                                        Focusable="False" HorizontalAlignment="Left">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <ContentPresenter/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsEnabled" Value="True">
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Border HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource PlateBadgeStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EntranceHasUnknownPlate}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerChipTextColor}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerChipBackgroundColor}"/>
                                                                        <Setter Property="BorderThickness" Value="1.4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EntranceDetectedVehicleNo}" Style="{DynamicResource PlateBadgeTextStyle}" />
                                                    </Border>
                                                </Button>
                                                <Border Style="{DynamicResource MemberChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding EntranceIsMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Member" Style="{DynamicResource MemberChipTextStyle}" />
                                                </Border>
                                                <Border Style="{DynamicResource VipChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding EntranceIsVip, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="VIP" Style="{DynamicResource VipChipTextStyle}" />
                                                </Border>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="Hidden">
                                                <Border Style="{DynamicResource InfoChipStyle}" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="" FontSize="10.5" Margin="4,0,4,0"
                                                                   Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />
                                                        <TextBlock Text="" FontSize="11.5" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{DynamicResource PrimaryChipStyle}" Visibility="{Binding ExitFeeDueText, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        
                                                        <TextBlock Text=" " FontSize="10.5" Margin="4,0,4,0"
                                                                   Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />
                                                        <TextBlock Text=" " FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                                        Command="{Binding OpenEntranceGateCommand}" Margin="0,0,0,0">
                                                    <TextBlock Text="Open Gate" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                </Button>
                                                <Button Grid.Column="1" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                                                        Command="{Binding RetryEntranceVisitorSaveCommand}" Margin="3,0,0,0">
                                                    <TextBlock Text="Manual Entry" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="2" Background="{DynamicResource SecondaryBackgroundColor}" ClipToBounds="True">
                                            <Button Command="{Binding OpenEntranceSnapshotCommand}"
                                                    Cursor="{Binding EntranceHasSnapshot, Converter={StaticResource BoolToCursorConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ButtonChrome" CornerRadius="2" Background="{DynamicResource SecondaryBackgroundColor}" ClipToBounds="True">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="#20FFFFFF" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="#30FFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Image Source="{Binding EntranceSnapshotImage}" Stretch="Uniform"
                                                           Visibility="{Binding EntranceHasSnapshot, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding EntranceHasSnapshot, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <fa:FontAwesome Icon="Camera" FontSize="18"
                                                                         Foreground="{DynamicResource SecondaryTextColor}"
                                                                         HorizontalAlignment="Center" />
                                                        <TextBlock Text="No snapshot" FontSize="9.5" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource SecondaryTextColor}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource ElevatedPanelStyle}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="110" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LaneAccentBarStyle}" Height="18" Margin="0,0,6,0"
                                                Background="{DynamicResource SecondaryAccentColor}"/>
                                        <TextBlock Text="Exit Lane" Style="{DynamicResource SmallTitleTextStyle}" FontSize="15" />
                                        <Border Style="{DynamicResource DangerChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Manual" Style="{DynamicResource DangerChipTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryOutlineButtonStyle}" Content="Clear"
                                                Padding="6,4"
                                                Command="{Binding TestExitEntryCommand}" Margin="0,0,6,0" />
                                        <Border Style="{DynamicResource StatusPillStyle}" VerticalAlignment="Center"
                                                Background="{Binding ExitGateOpen, Converter={StaticResource GateStateBrushConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LiveDotStyle}" Fill="{DynamicResource PureWhiteColor}" Margin="0,0,4,0"/>
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PureWhiteColor}"
                                                           Text="{Binding ExitGateStateText}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Margin="6,0,0,0" Command="{Binding RefreshExitCameraCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <fa:FontAwesome Icon="Refresh" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Margin="0,0,3,0" Background="{DynamicResource PrimaryDarkColor}"
                                            CornerRadius="2" ClipToBounds="True">
                                        <Grid>
                                            <player:RtspStreamPlayer x:Name="ExitAnprControl"
                                                            Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Margin="6"
                                                        Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Ellipse Style="{StaticResource LiveDotStyle}" Fill="{DynamicResource PrimaryRedColor}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ExitAnprName}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PureWhiteColor}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource SkeletonShimmerStyle}"
                                                    Visibility="{Binding IsPreloadLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Margin="3,0,0,0" Background="{DynamicResource PrimaryDarkColor}"
                                            CornerRadius="2" ClipToBounds="True">
                                        <Grid>
                                            <player:RtspStreamPlayer x:Name="ExitCctvControl"
                                                            Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Margin="6"
                                                        Visibility="{Binding IsPreloadLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Ellipse Style="{StaticResource LiveDotStyle}" Fill="{DynamicResource PrimaryRedColor}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ExitCctvName}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PureWhiteColor}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource SkeletonShimmerStyle}"
                                                    Visibility="{Binding IsPreloadLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="2" Margin="0,6,0,6" FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextColor}"
                                           Text="{Binding ExitStatusText}" TextTrimming="CharacterEllipsis" />

                                <Border Grid.Row="3" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="2" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <Button Command="{Binding OpenExitPlateSearchCommand}"
                                                        IsEnabled="{Binding ExitHasUnknownPlate}"
                                                        Focusable="False" HorizontalAlignment="Left">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <ContentPresenter/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsEnabled" Value="True">
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Border HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource PlateBadgeStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ExitHasUnknownPlate}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerChipTextColor}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerChipBackgroundColor}"/>
                                                                        <Setter Property="BorderThickness" Value="1.4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ExitDetectedVehicleNo}" Style="{DynamicResource PlateBadgeTextStyle}" />
                                                    </Border>
                                                </Button>
                                                <Border Style="{DynamicResource MemberChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding ExitIsMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Member" Style="{DynamicResource MemberChipTextStyle}" />
                                                </Border>
                                                <Border Style="{DynamicResource VipChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding ExitIsVip, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="VIP" Style="{DynamicResource VipChipTextStyle}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Style="{DynamicResource InfoChipStyle}" Margin="0,0,6,0"
                                                        Visibility="{Binding ExitParkedDurationText, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <fa:ImageAwesome Icon="ClockOutline" Width="11" Height="11" Foreground="{DynamicResource PrimaryColor}" />
                                                        
                                                        <TextBlock Margin="6,0,0,0" Text="{Binding ExitParkedDurationText}" FontSize="11.5" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{DynamicResource PrimaryChipStyle}" Visibility="{Binding ExitFeeDueText, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <fa:ImageAwesome Icon="Usd" Width="11" Height="11" Foreground="{DynamicResource PrimaryColor}" />
                                                        
                                                        <TextBlock  Margin="6,0,0,0" Text="{Binding ExitFeeDueText}" FontSize="13.5" FontWeight="Bold"
                                                                    Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{DynamicResource SecondaryButtonStyle}"
                                                        Command="{Binding OpenExitGateCommand}" Margin="0,0,0,0">
                                                    <TextBlock Text="Open Gate" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                </Button>
                                                <Button Grid.Column="1" Style="{DynamicResource InfoButtonStyle}" HorizontalAlignment="Stretch"
                                                        Command="{Binding OpenPaymentModalCommand}" Margin="3,0,0,0">
                                                    <TextBlock Text="Confirm Payment" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="2" Background="{DynamicResource SecondaryBackgroundColor}" ClipToBounds="True">
                                            <Button Command="{Binding OpenExitSnapshotCommand}"
                                                    Cursor="{Binding ExitHasSnapshot, Converter={StaticResource BoolToCursorConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ButtonChrome" CornerRadius="2" Background="{DynamicResource SecondaryBackgroundColor}" ClipToBounds="True">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="#20FFFFFF" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="#30FFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Image Source="{Binding ExitSnapshotImage}" Stretch="Uniform"
                                                           Visibility="{Binding ExitHasSnapshot, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding ExitHasSnapshot, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <fa:FontAwesome Icon="Camera" FontSize="18"
                                                                         Foreground="{DynamicResource SecondaryTextColor}"
                                                                         HorizontalAlignment="Center" />
                                                        <TextBlock Text="No snapshot" FontSize="9.5" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource SecondaryTextColor}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Height="0" Background="Transparent" />

                <Border Grid.Row="3" Padding="10,0,10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="300" />
                            <ColumnDefinition Width="1.2*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- Recent Visitors -->
                        <sections:RecentVisitorsSection Grid.Column="0" Margin="0,0,4,0" x:Name="RecentVisitorsSection" />

                        <!-- Security Alerts -->
                        <Border Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ElevatedPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="10,8,10,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Border x:Name="AlertPulseDot" Width="10" Height="10" CornerRadius="0" Margin="0,0,6,0"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Source={StaticResource PrimaryRedColor}, Path=Color}" />
                                            </Border.Background>
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActiveAlerts}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="AlertPulseStoryboard">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <ColorAnimation
                                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                            To="#FFF7BFC4" Duration="0:0:0.9" />
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                            To="1.5" Duration="0:0:0.9" />
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                            To="1.5" Duration="0:0:0.9" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="AlertPulseStoryboard" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="Security Alerts" Style="{DynamicResource SmallTitleTextStyle}" FontSize="15" />
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right" Style="{DynamicResource DangerChipStyle}" VerticalAlignment="Center"
                                            Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ActiveAlertCountText}" Style="{DynamicResource DangerChipTextStyle}" />
                                    </Border>
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="8,0,8,8">
                                    <TextBlock Text="No active alerts" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextColor}"
                                               Visibility="{Binding HasActiveAlerts, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="AlertsScrollViewer"
                                                  ScrollChanged="AlertsScrollViewer_OnScrollChanged"
                                                  Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding SecurityAlerts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource MutedChipBackgroundColor}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderColor}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerChipBackgroundColor}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryRedColor}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningChipBackgroundColor}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentColor}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PlateNumber}"
                                                                           FontWeight="Bold" FontSize="13.5"
                                                                           Foreground="{DynamicResource PrimaryBlackColor}" />

                                                                <Border DockPanel.Dock="Right" CornerRadius="2" Padding="6,2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource MutedButtonColor}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryRedColor}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                                    <Setter Property="Background" Value="{DynamicResource SecondaryAccentColor}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding TagLabel}" FontSize="9.5" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PureWhiteColor}" />
                                                                </Border>
                                                            </DockPanel>

                                                            <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="11.5"
                                                                       Margin="0,4,0,6" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource SecondaryTextColor}" />

                                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                                <Button Content="{Binding PrimaryActionLabel}"
                                                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                                        Command="{Binding PrimaryActionCommand}"
                                                                        Padding="8,3" Margin="0,0,6,0" />
                                                                <Button Content="Dismiss" Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                                        Command="{Binding DismissCommand}" Padding="8,3"
                                                                        IsEnabled="{Binding IsDismissing, Converter={StaticResource InverseBoolConverter}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="0"
                    Visibility="{Binding LoadError, Converter={StaticResource NullToVisibilityConverter}}"
                    d:DesignHeight="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LoadError}" FontSize="13"
                               Foreground="{DynamicResource PrimaryRedColor}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"
                               MaxWidth="360" TextAlignment="Center" />
                    <Button Content="Retry" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                            Command="{Binding RetryLoadCommand}" Width="120" />
                </StackPanel>
            </Border>

            <Border Background="#CC000000"
                    Visibility="{Binding IsSnapshotModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    d:DesignHeight="0">
                <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="3"
                        BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1"
                        Padding="12" MaxWidth="720" MaxHeight="600"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ModalSnapshotTitle}"
                                       Style="{DynamicResource SmallTitleTextStyle}" FontSize="15" />
                            <Button DockPanel.Dock="Right" Command="{Binding CloseSnapshotModalCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
                                                <Setter Property="Cursor" Value="Hand" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <fa:FontAwesome Icon="Close" />
                            </Button>
                        </DockPanel>

                        <Border Grid.Row="1" Background="{DynamicResource PrimaryDarkColor}" CornerRadius="2" ClipToBounds="True">
                            <Image Source="{Binding ModalSnapshotImage}" Stretch="Uniform" />
                        </Border>

                        <Button Grid.Row="2" Content="Re-capture" Style="{StaticResource PrimaryOutlineButtonStyle}"
                                Command="{Binding RecaptureSnapshotCommand}"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </Border>
            <Border Background="#CC000000"
        Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
        d:DesignHeight="0">
    <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="3"
            BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1"
            Padding="14" Width="520"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" Text="Confirm Payment"
                           Style="{DynamicResource SmallTitleTextStyle}" FontSize="16" />
                <Button DockPanel.Dock="Right" Command="{Binding ClosePaymentModalCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <fa:FontAwesome Icon="Close" />
                </Button>
            </DockPanel>

            <!-- Vehicle summary -->
            <Border Grid.Row="1" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="2"
                    Padding="10" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource PlateBadgeStyle}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ExitDetectedVehicleNo}" Style="{DynamicResource PlateBadgeTextStyle}" />
                    </Border>
                    <Border Style="{DynamicResource MemberChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ExitIsMember, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Member" Style="{DynamicResource MemberChipTextStyle}" />
                    </Border>
                    <Border Style="{DynamicResource VipChipStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ExitIsVip, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="VIP" Style="{DynamicResource VipChipTextStyle}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Duration / Fee -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Style="{DynamicResource InfoChipStyle}" Margin="0,0,6,0"
                        Visibility="{Binding ExitParkedDurationText, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="ClockOutline" Width="11" Height="11" Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock Text="Parked" FontSize="10.5" Margin="4,0,4,0"
                                   Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ExitParkedDurationText}" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource PrimaryChipStyle}"
                        Visibility="{Binding ExitFeeDueText, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Usd" Width="11" Height="11" Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock Text="Fee Due" FontSize="10.5" Margin="4,0,4,0"
                                   Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />
                        <TextBlock FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryColor}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ExitFeeDueText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocChecked}" Value="True">
                                            <Setter Property="Text" Value="0.00 (FOC)" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FOC checkbox -->
            <CheckBox Grid.Row="3" Content="Free of Charge (FOC)" IsChecked="{Binding IsFocChecked}"
                      Margin="0,0,0,10" FontSize="12.5" Foreground="{DynamicResource PrimaryTextColor}"
                      Visibility="{Binding EntranceIsMember, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                      Checked="ToggleButton_OnChecked"
                      Unchecked="ToggleButton_OnUnchecked"
                      VerticalContentAlignment="Center">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="0"
                                                BorderThickness="1.6" BorderBrush="{DynamicResource PrimaryBorderColor}"
                                                Background="{DynamicResource PrimaryBackgroundColor}">
                                            <fa:ImageAwesome x:Name="Check" Icon="Check" Width="10" Height="10"
                                                              Foreground="{DynamicResource PureWhiteColor}"
                                                              Visibility="Collapsed"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryColor}" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!-- Payment method label -->
            <TextBlock Grid.Row="4" Text="Payment Method" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,6"
                       Visibility="{Binding IsShowPayments, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Payment method chips -->
            <ListBox Grid.Row="5" ItemsSource="{Binding PaymentMethods}"
                     SelectedItem="{Binding SelectedPaymentMethod}"
                     BorderThickness="0" Background="Transparent" Margin="0,0,0,10"
                     Visibility="{Binding IsShowPayments, Converter={StaticResource BoolToVisibilityConverter}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Desc}" FontSize="12.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBlackColor}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PureWhiteColor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ChipBorder" CornerRadius="2" Padding="{TemplateBinding Padding}"
                                            BorderThickness="1.2"
                                            
                                            BorderBrush="{DynamicResource SecondaryBorderColor}"
                                            Background="{DynamicResource PrimaryChipBackgroundColor}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource PrimaryColor}" />
                                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel Grid.Row="6" Margin="0,0,0,10">
                <TextBlock Text="Remark" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextColor}" Margin="0,0,0,5" />
                <input:FormTextArea Value="{Binding ExitRemark, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12.5" 
                                     InputHeight="54"
                                     ContentPadding="8,6"
                                     BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                     Color="{DynamicResource PrimaryBlackColor}"
                                     BorderSize="1.2" />
            </StackPanel>
            
            <!-- Actions -->
            <DockPanel Grid.Row="7" LastChildFill="True">
                <Button Content="Cancel" Style="{DynamicResource SecondaryOutlineButtonStyle}"
                        Command="{Binding ClosePaymentModalCommand}" Width="120" DockPanel.Dock="Left" />
                <Button Content="Confirm Payment" Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding ConfirmPaymentModalCommand}"
                        HorizontalAlignment="Stretch" Margin="8,0,0,0" />
            </DockPanel>
        </Grid>
    </Border>
</Border>
            
            <Border Background="#CC000000"
        Visibility="{Binding IsPlateSearchModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
        d:DesignHeight="0">
    <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="3"
            BorderBrush="{DynamicResource PrimaryBorderColor}" BorderThickness="1"
            Padding="14" Width="480"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" Text="Find Vehicle"
                           Style="{DynamicResource SmallTitleTextStyle}" FontSize="16" />
                <Button DockPanel.Dock="Right" Command="{Binding ClosePlateSearchModalCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <fa:FontAwesome Icon="Close" />
                </Button>
            </DockPanel>

            <input:FormSearchTextField x:Name="PlateSearchField" Grid.Row="1" Margin="0,0,0,10"
                                       PlaceHolder="Enter plate number"
                                       NotEmpty="False"
                                       ContentPadding="8,6"
                                       BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                                       Color="{DynamicResource PrimaryBlackColor}"
                                       BorderSize="1.2" />

            <Button Grid.Row="3" Content="Confirm" Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding ConfirmManualPlateCommand}" HorizontalAlignment="Stretch"
                    Visibility="{Binding IsPlateSearchManualEntry, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Border>
</Border>
        </Grid>
    </Border>
</UserControl>