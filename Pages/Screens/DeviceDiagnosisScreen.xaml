<UserControl x:Class="icpms_client.Pages.Screens.DeviceDiagnosisScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="{DynamicResource PrimaryBackgroundColor}">

    <UserControl.Resources>
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBlackColor}" />
        </Style>

        <Style x:Key="HealthChipBorderStyle" TargetType="Border" BasedOn="{StaticResource MutedChipStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthState}" Value="Online">
                    <Setter Property="Background" Value="{DynamicResource SuccessChipBackgroundColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Degraded">
                    <Setter Property="Background" Value="{DynamicResource WarningChipBackgroundColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Offline">
                    <Setter Property="Background" Value="{DynamicResource DangerChipBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HealthChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedChipTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthState}" Value="Online">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessChipTextColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Degraded">
                    <Setter Property="Foreground" Value="{DynamicResource WarningChipTextColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Offline">
                    <Setter Property="Foreground" Value="{DynamicResource DangerChipTextColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KindIconStyle" TargetType="fa:ImageAwesome">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Icon" Value="Cog" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="AnprCamera">
                    <Setter Property="Icon" Value="Camera" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="LedDisplay">
                    <Setter Property="Icon" Value="Television" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="GateController">
                    <Setter Property="Icon" Value="Road" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="LoopDetector">
                    <Setter Property="Icon" Value="Plug" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Cctv">
                    <Setter Property="Icon" Value="VideoCamera" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowCheckButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallSecondaryButtonStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Margin" Value="0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckAllButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileBorderStyle" TargetType="Border" BasedOn="{StaticResource ElevatedPanelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightColor}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileAccentStyle" TargetType="Border" BasedOn="{StaticResource LaneAccentBarStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="Online">
                    <Setter Property="Background" Value="{DynamicResource PrimaryGreenColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Degraded">
                    <Setter Property="Background" Value="{DynamicResource WarningColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Offline">
                    <Setter Property="Background" Value="{DynamicResource PrimaryRedColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Unknown">
                    <Setter Property="Background" Value="{DynamicResource SecondaryBorderColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchPlaceholderStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBorderColor}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DEVICE DIAGNOSIS" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="Gate device health — LAN reachability and serial link checks"
                           Style="{StaticResource CellTextStyle}"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Refresh" Width="10" Height="10" Margin="0,0,6,0"
                                         Foreground="{DynamicResource PrimaryBlackColor}" />
                        <TextBlock Text="REFRESH LIST" FontSize="11" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CheckAllButtonStyle}"
                        Command="{Binding CheckAllCommand}"
                        Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Play" Width="10" Height="10" Margin="0,0,6,0"
                                         Foreground="{DynamicResource SurfaceBrush}" />
                        <TextBlock Text="CHECK ALL" FontSize="11" Foreground="{DynamicResource SurfaceBrush}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource StopButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Margin="6,0,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Stop" Width="10" Height="10" Margin="0,0,6,0"
                                         Foreground="{DynamicResource SurfaceBrush}" />
                        <TextBlock Text="CANCEL" FontSize="11" Foreground="{DynamicResource SurfaceBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryTiles}" Margin="0,10,-6,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ContainerButtonStyle}"
                            Margin="0,0,6,0"
                            Command="{Binding DataContext.SetStatusFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Key}">
                        <Border Style="{StaticResource TileBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource TileAccentStyle}" />
                                <StackPanel Grid.Column="1" Margin="10,6">
                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextColor}" />
                                    <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="320"
                    Padding="8,5"
                    Background="{DynamicResource PrimaryBackgroundColor}"
                    BorderBrush="{DynamicResource PrimaryBorderColor}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid>
                    <fa:ImageAwesome Icon="Search" Width="11" Height="11" HorizontalAlignment="Left"
                                     Foreground="{DynamicResource SecondaryTextColor}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="Search name, gate, type, IP, COM port"
                               Style="{StaticResource SearchPlaceholderStyle}"
                               Margin="22,0,0,0" />
                </Grid>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="{Binding ProgressText}"
                       Style="{StaticResource CellTextStyle}"
                       FontWeight="Bold"
                       HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="10,6"
                CornerRadius="2"
                Background="{DynamicResource DangerChipBackgroundColor}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource CellTextStyle}"
                       Foreground="{DynamicResource DangerChipTextColor}"
                       FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding DevicesView}"
                      Style="{StaticResource TableDataGridStyle}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATUS" Width="160" SortMemberPath="HealthState">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource HealthChipBorderStyle}">
                                        <TextBlock Text="{Binding HealthLabel}"
                                                   Style="{StaticResource HealthChipTextStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource InfoChipStyle}"
                                            Margin="4,0,0,0"
                                            Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="SIM" Style="{StaticResource InfoChipTextStyle}" />
                                    </Border>
                                    <fa:ImageAwesome Icon="Spinner" Spin="True" Width="11" Height="11"
                                                     Margin="6,0,0,0"
                                                     Foreground="{DynamicResource PrimaryColor}"
                                                     Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="DEVICE" Width="*" MinWidth="170" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:ImageAwesome Style="{StaticResource KindIconStyle}" />
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               Style="{StaticResource CellTextStyle}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TYPE" Width="190" SortMemberPath="KindLabel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KindLabel}" ToolTip="{Binding KindLabel}"
                                           Style="{StaticResource CellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="GATE" Width="120" SortMemberPath="GateName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GateName}" ToolTip="{Binding GateName}"
                                           Style="{StaticResource CellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="CONNECTION" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SecondaryChipStyle}">
                                        <TextBlock Text="{Binding ConnectionLabel}"
                                                   Style="{StaticResource SecondaryChipTextStyle}" />
                                    </Border>
                                    <TextBlock Text="{Binding Endpoint}"
                                               Style="{StaticResource CellTextStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="LATENCY" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LatencyText}"
                                           Style="{StaticResource CellTextStyle}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="LAST CHECKED" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CheckedAtText}" Style="{StaticResource CellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="NOTE" Width="1.5*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Note}" ToolTip="{Binding Note}"
                                           Style="{StaticResource CellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="84">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowCheckButtonStyle}"
                                        Command="{Binding CheckCommand}"
                                        Content="CHECK" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Width="14" Height="14"
                                 Foreground="{DynamicResource PrimaryColor}" />
                <TextBlock Text="Loading devices…" Style="{StaticResource CellTextStyle}" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="No devices configured"
                       Style="{StaticResource CellTextStyle}"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>