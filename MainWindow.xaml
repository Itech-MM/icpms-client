<base:BaseWindow x:Class="icpms_client.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:base="clr-namespace:icpms_client.Common.UI"
                 xmlns:converters="clr-namespace:icpms_client.Common.Converters"
                 xmlns:fa="http://schemas.fontawesome.io/icons/"
                 WindowState="Maximized"
                 WindowStyle="None"
                 ResizeMode="CanResizeWithGrip"
                 UseLayoutRounding="True"
                 Icon="Assets/Images/FlexiTech-Logo-Icon.ico"
                 Title="FlexiTech | ICPMS" Width="800">

    <WindowChrome.WindowChrome>
        <WindowChrome
            ResizeBorderThickness="0"
            CaptionHeight="44"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:WindowStateToIconConverter x:Key="WindowStateToIconConverter"/>
    </Window.Resources>
    <Grid Background="{DynamicResource PrimaryBackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryTitleBarColor}"
                Padding="10,6"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompanyNameLabelTextStyle}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding TerminalLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource SmallTitleTextStyle}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontWeight="Normal"
                               Margin="12,2,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Style="{StaticResource StatusPillStyle}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Visibility="{Binding Authenticated, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Circle"
                                              Width="8" Height="8"
                                              Foreground="{DynamicResource PrimaryGreenColor}"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="System Online"
                                       Style="{StaticResource UserSessionTextStyle}"
                                       Foreground="{DynamicResource PrimaryGreenColor}"
                                       FontWeight="Bold"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="StopButton"
                            Style="{StaticResource StopButtonStyle}"
                            Click="StopButton_Click"
                            Margin="0,0,10,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding Authenticated, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Stop"
                                              Width="12" Height="12"
                                              Foreground="White"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="STOP"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource ThemeToggleButtonStyle}"
                            Click="ThemeToggleButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Toggle theme">
                        <fa:ImageAwesome Icon="MoonOutline" Style="{StaticResource HeaderIconStyle}"/>
                    </Button>

                    <Grid Margin="4,0,4,0"
                          Visibility="{Binding Authenticated, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button x:Name="NotificationsButton"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="NotificationsButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Notifications">
                            <fa:ImageAwesome Icon="Bell" Style="{StaticResource HeaderIconStyle}"/>
                        </Button>
                        <Border Background="{DynamicResource PrimaryRedColor}"
                                CornerRadius="7"
                                Width="14" Height="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                Visibility="{Binding HasNotifications, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding NotificationCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Button x:Name="SettingsButton"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="SignOutButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Settings"
                            Visibility="{Binding Authenticated, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <fa:ImageAwesome Icon="SignOut" Style="{StaticResource HeaderIconStyle}"/>
                    </Button>

                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <fa:FontAwesome Icon="Minus" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <fa:FontAwesome
                            Icon="{Binding WindowState,
                      RelativeSource={RelativeSource AncestorType=Window},
                      Converter={StaticResource WindowStateToIconConverter}}"
                            VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Click="Close_Click" Tag="Close" WindowChrome.IsHitTestVisibleInChrome="True">
                        <fa:FontAwesome Icon="Close" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="MainWindowFrame" Grid.Row="1" Grid.Column="0" />
    </Grid>
</base:BaseWindow>