<UserControl x:Class="icpms_client.UserControls.UI.Reusable.Buttons.TextButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:icpms_client.UserControls.UI.Reusable.Buttons"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary Source="ButtonStyle.xaml" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Background="{Binding BackgroundColor, RelativeSource={RelativeSource AncestorType=UserControl}}"-->
        <Button Grid.ColumnSpan="2" Content="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource TextButtonStyle}"
                Foreground="{Binding TextColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Background="{Binding BackgroundColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Padding="{Binding Padding}"
                MaxHeight="{Binding MaxButtonHeight,RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="{Binding ButtonHeight,RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="Button_Click"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
        />
    </Grid>
</UserControl>
