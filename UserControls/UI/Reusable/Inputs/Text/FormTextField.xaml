<forms:FormField x:Class="icpms_client.UserControls.UI.Reusable.Inputs.Text.FormTextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utils="clr-namespace:icpms_client.UserControls.UI.Reusable.Utils"
             xmlns:forms="clr-namespace:icpms_client.UserControls.Customs.Forms.Validations.Form"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="250">
    <Grid>
        <!-- Define rows for Input and Error Message -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Input Field -->
            <RowDefinition Height="Auto"/>
            <!-- Error Message -->
        </Grid.RowDefinitions>

        <!-- Border wraps the input -->
        <Border
                Grid.Row="0"
                Background="{Binding BackgroundColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CornerRadius="{Binding RoundedRadius, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                Padding="{Binding Padding}" 
                BorderThickness="{Binding BorderSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Use DynamicResource to prevent static sharing -->
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <Binding Path="Color" 
                                     RelativeSource="{RelativeSource AncestorType=forms:FormField}"
                                     Converter="{utils:LighterBrushConverterExtension}"
                                     FallbackValue="Transparent"/>
                        </Setter.Value>
                    </Setter>
        
                    <Style.Triggers>
                        <!-- Use FallbackValue for safety -->
                        <DataTrigger Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType=forms:FormField}, FallbackValue=False}" 
                                     Value="True">
                            <Setter Property="BorderBrush" Value="Red"/>
                        </DataTrigger>
            
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInputFocus, RelativeSource={RelativeSource AncestorType=forms:FormField}, FallbackValue=False}" 
                                           Value="True"/>
                                <Condition Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType=forms:FormField}, FallbackValue=False}" 
                                           Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <Binding Path="FocusColor" 
                                             RelativeSource="{RelativeSource AncestorType=forms:FormField}"
                                             FallbackValue="Transparent"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- Placeholder Text -->
                <TextBlock x:Name="TxtBlock"
                           Margin="{Binding ContentPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Text="{Binding PlaceHolder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding Color, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={utils:LighterBrushConverterExtension}}"
                           VerticalAlignment="Center" 
                           TextAlignment="{Binding FormTextAlignment,RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Panel.ZIndex="-1"
                           Cursor="{Binding Cursor}"
                />
                <!-- Input TextBox -->
                <TextBox x:Name="TxtBox"
                         Cursor="{Binding Cursor}"
                         Margin="{Binding ContentPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Foreground="{Binding Color, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         CaretBrush="{Binding Color, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         TextWrapping="NoWrap"
                         Focusable="True"
                         TextAlignment="{Binding FormTextAlignment,RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         GotFocus="TxtBlock_OnGotFocus"
                         LostFocus="TxtBlock_OnLostFocus"
                         TextChanged="txtBox_onChanged"
                         BorderBrush="Transparent"
                         IsReadOnly="{Binding Readonly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsEnabled="{Binding Enable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         BorderThickness="0" 
                         PreviewTextInput="TxtBox_OnPreviewTextInput"
                         >
                </TextBox>
                
               
            </Grid>
        </Border>

        <!-- Error Message below the Input -->
        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="1"
                   Foreground="Red"
                   FontSize="12"
                   Margin="5,2,0,0"
                   Visibility="Collapsed"
                   Text="{Binding ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap"/>
    </Grid>
</forms:FormField>
