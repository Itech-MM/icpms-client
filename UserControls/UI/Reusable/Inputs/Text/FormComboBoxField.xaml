<forms:FormField x:Class="icpms_client.UserControls.UI.Reusable.Inputs.Text.FormComboBoxField"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:icpms_client.UserControls.UI.Reusable.Inputs.Text"
                 xmlns:forms="clr-namespace:icpms_client.UserControls.Customs.Forms.Validations.Form"
                 xmlns:fa="http://schemas.fontawesome.io/icons/"
                 xmlns:utils="clr-namespace:icpms_client.UserControls.UI.Reusable.Utils"
                 mc:Ignorable="d"
                 d:DesignHeight="50" d:DesignWidth="300">
    <forms:FormField.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NormalButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="5"
                                Padding="3"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Trigger -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{DynamicResource PrimaryTextFocusColor}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{DynamicResource PrimaryTextFocusColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

       
    </forms:FormField.Resources>
    <Grid Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Input Field -->
                <RowDefinition Height="Auto" />
                <!-- Error Message -->
            </Grid.RowDefinitions>
            <Border x:Name="RootBorder"
                    Cursor="Hand"
                    Padding="{Binding ContentPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{Binding BackgroundColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CornerRadius="{Binding RoundedRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    BorderThickness="{Binding BorderSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <Binding Path="Color" 
                                         RelativeSource="{RelativeSource AncestorType=UserControl}"
                                         Converter="{utils:LighterBrushConverterExtension}"/>
                            </Setter.Value>
                        </Setter>
                        
                        <Style.Triggers>
                            
                            
                            <DataTrigger Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType={x:Type local:FormComboBoxField}}}" Value="True">
                                <Setter Property="BorderBrush" Value="Red"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOpen, ElementName=Popup}" Value="True"/>
                                    <Condition Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType={x:Type local:FormComboBoxField}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{Binding FocusColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button Click="OnSearch_Click" Style="{DynamicResource ContainerButtonStyle}"
                        HorizontalContentAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:FormTextField x:Name="TextField"
                                             Value="{Binding Selected.Label, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                             Color="{Binding Color, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             VerticalAlignment="Center"
                                             Cursor="Hand"
                                             BorderSize="0"
                                             ContentPadding="0,0"
                                             Length="{Binding Length,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             PlaceHolder="{Binding PlaceHolder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Enable="False" />
                        <Border Grid.Column="1" BorderBrush="Transparent" BorderThickness="0">
                            <fa:FontAwesome VerticalAlignment="Center" Icon="AngleDown" IsHitTestVisible="False"
                                            >
                                <fa:FontAwesome.Style>
                                    <Style TargetType="fa:FontAwesome">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Path="Color" 
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                         Converter="{utils:LighterBrushConverterExtension}"/>
                                            </Setter.Value>
                                        </Setter>
                                        
                                        <Style.Triggers>
                                            
                                            <DataTrigger Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType={x:Type local:FormComboBoxField}}}" Value="True">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsOpen, ElementName=Popup}" Value="True"/>
                                                    <Condition Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType={x:Type local:FormComboBoxField}}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{Binding FocusColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </fa:FontAwesome.Style>
                            </fa:FontAwesome>
                        </Border>
                    </Grid>
                </Button>
            </Border>
            <TextBlock x:Name="ErrorTextBlock"
                       Grid.Row="1"
                       Foreground="Red"
                       FontSize="12"
                       Margin="5,2,0,0"
                       Visibility="Collapsed"
                       Text="{Binding ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextWrapping="Wrap" />
        </Grid>
        <!-- Popup for displaying suggestions or content -->
        <Popup x:Name="Popup"
               PlacementTarget="{Binding ElementName=RootBorder}"
               Placement="Bottom"
               StaysOpen="False"
               Opened="OnGotFocus"
               Closed="OnLostFocus"
               IsOpen="{Binding IsPopupOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
               AllowsTransparency="True">

            <Border
                Margin="5"
                Background="{DynamicResource PrimaryBackgroundColor}"
                BorderBrush="{DynamicResource PrimaryBorderColor}"
                BorderThickness="1"
                CornerRadius="5"
                Width="{Binding ActualWidth, ElementName=RootBorder}">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      Direction="270"
                                      ShadowDepth="2"
                                      BlurRadius="10"
                                      Opacity="0.3" />
                </Border.Effect>
                <ScrollViewer x:Name="PopupScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="300">
                    <ItemsControl x:Name="ItemsControl"
                                  ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Style="{DynamicResource NormalButton}"
                                        Click="OnResult_Click"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsEnabled}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</forms:FormField>